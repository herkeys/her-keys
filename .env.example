# RevenueCat public SDK API keys (client-safe by RevenueCat's own definition).
# Never put a secret key (sk_...) in any EXPO_PUBLIC_ variable or committed file.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Existing Build 2 configuration (unchanged).
EXPO_PUBLIC_HERKEYS_DATA_MODE=
EXPO_PUBLIC_HERKEYS_INTERNAL_TOOLS=

# Supabase project connection (src/config/supabase.ts). The anon/publishable key
# is client-safe by design -- RLS enforces access, not this key. Never put a
# service_role key in any EXPO_PUBLIC_ variable or committed file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client ids, per platform (src/config/supabase.ts). Absent means
# "do not offer Google" for that platform.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

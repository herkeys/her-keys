# RevenueCat public SDK API keys (client-safe by RevenueCat's own definition).
# Never put a secret key (sk_...) in any EXPO_PUBLIC_ variable or committed file.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Existing Build 2 configuration (unchanged).
EXPO_PUBLIC_HERKEYS_DATA_MODE=
EXPO_PUBLIC_HERKEYS_INTERNAL_TOOLS=

# Her Keys External Intelligence Edge Function secrets.
# Copy to supabase/functions/.env for LOCAL development only.
# Never commit the real file. Hosted secrets belong in Supabase Edge Function Secrets.

# Apple WeatherKit REST — server-side only.
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
# PEM text may be pasted with literal \n sequences; the function normalizes them.
WEATHERKIT_PRIVATE_KEY_P8=

# Google Calendar OAuth — use a Web application OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 32 random bytes encoded as base64. Used only to encrypt provider refresh tokens at rest.
# Generate once with a cryptographically secure tool; never reuse a public/client key.
EXTERNAL_TOKEN_ENCRYPTION_KEY_B64=

# Optional. Defaults to the Her Keys custom scheme used by the app.
HERKEYS_CALENDAR_APP_REDIRECT_URI=herkeys://calendar-connected

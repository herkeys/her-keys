# Her Keys External Intelligence Edge Function secrets.
# Copy to supabase/functions/.env for LOCAL development only.
# Never commit the real file. Hosted secrets belong in Supabase Edge Function Secrets.

# Apple WeatherKit REST — server-side only.
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
# PEM text may be pasted with literal \n sequences; the function normalizes them.
WEATHERKIT_PRIVATE_KEY_P8=

# Google Calendar OAuth — use a Web application OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 32 random bytes encoded as base64. Used only to encrypt provider refresh tokens at rest.
# Generate once with a cryptographically secure tool; never reuse a public/client key.
EXTERNAL_TOKEN_ENCRYPTION_KEY_B64=

# Optional. Defaults to the Her Keys custom scheme used by the app.
HERKEYS_CALENDAR_APP_REDIRECT_URI=herkeys://calendar-connected

# ---------------------------------------------------------------------------------------------------------------------------------
# Her Keys Premium (Stage 1). SERVER-SIDE ONLY. Independent values for Staging and Production; never reuse one across environments.
# Hosted values belong in Supabase Edge Function Secrets. The RevenueCat PUBLIC SDK keys (EXPO_PUBLIC_REVENUECAT_*) are NOT credentials
# here and are rejected if configured as one.
# ---------------------------------------------------------------------------------------------------------------------------------
# Which deployment this is: local | staging | production. Staging accepts SANDBOX webhook events only; production accepts PRODUCTION only.
PREMIUM_ENVIRONMENT=
# The Authorization header value configured on the RevenueCat webhook integration (16+ random characters; verified in constant time).
REVENUECAT_WEBHOOK_AUTH=
# The HMAC signing secret shown once by RevenueCat when "HMAC webhook signing" is enabled. REQUIRED when PREMIUM_ENVIRONMENT=production.
REVENUECAT_WEBHOOK_HMAC_SECRET=
# RevenueCat REST v1 SECRET API key (sk_...), used only to read a subscriber's authenticated record for reconciliation.
REVENUECAT_SECRET_API_KEY=
# Operator secret for the premium-ops endpoint (24+ random characters).
PREMIUM_OPS_SECRET=

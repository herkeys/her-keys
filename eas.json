{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HERKEYS_BACKEND": "staging",
        "EXPO_PUBLIC_REVENUECAT_STORE": "test",
        "EXPO_PUBLIC_HERKEYS_DATA_MODE": "empty",
        "EXPO_PUBLIC_HERKEYS_V2_CONSENT_GATE": "true"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HERKEYS_BACKEND": "staging",
        "EXPO_PUBLIC_REVENUECAT_STORE": "native",
        "EXPO_PUBLIC_HERKEYS_DATA_MODE": "empty",
        "EXPO_PUBLIC_HERKEYS_V2_CONSENT_GATE": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HERKEYS_BACKEND": "production",
        "EXPO_PUBLIC_REVENUECAT_STORE": "native",
        "EXPO_PUBLIC_HERKEYS_DATA_MODE": "empty",
        "EXPO_PUBLIC_HERKEYS_V2_CONSENT_GATE": "true"
      }
    },
    "smoke-production-android": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HERKEYS_BACKEND": "production",
        "EXPO_PUBLIC_REVENUECAT_STORE": "native",
        "EXPO_PUBLIC_HERKEYS_DATA_MODE": "empty",
        "EXPO_PUBLIC_HERKEYS_V2_CONSENT_GATE": "true"
      }
    },
    "diagnostic-android": {
      "environment": "development",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HERKEYS_BACKEND": "staging",
        "EXPO_PUBLIC_REVENUECAT_STORE": "test",
        "EXPO_PUBLIC_HERKEYS_DATA_MODE": "empty",
        "EXPO_PUBLIC_HERKEYS_V2_CONSENT_GATE": "true",
        "EXPO_PUBLIC_HK_AUTH_DIAG": "1"
      }
    }
  }
}
